{
  "name": "nodets-template",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env ENVIROMENT=DEV nodemon",
    "prod": "cross-env ENVIROMENT=PROD nodemon",
    "test": "jest --runInBand",
    "build": "tsup ./src/index.ts",
    "seed": "tsx ./src/.scripts/runSeeder.ts",
    "create:router": "tsx ./src/.scripts/createRouter.ts",
    "create:controller": "tsx ./src/.scripts/createController.ts",
    "create:seeder": "tsx ./src/.scripts/createSeeder.ts",
    "insert:controller": "tsx ./src/.scripts/insertController.ts",
    "insert:env": "tsx ./src/.scripts/insertEnv.ts",
    "prepare": "husky",
    "create:env-example": "tsx ./src/.scripts/createEnvExample.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@swc/jest": "^0.2.37",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "msw": "^2.10.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "chalk": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.5.0"
  },
  "prisma": {
    "schema": "./src/models"
  },
  "jest": {
    "clearMocks": true,
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 10000,
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/jest.setup.ts",
      "<rootDir>/src/tests/singleton.ts"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "@swc/jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
